# ============================================================
#  คัดลอกไฟล์นี้เป็น .env แล้วเติมคีย์จาก Supabase
#     Supabase → Project Settings → Data API / API Keys
#  .env ถูก .gitignore ไว้แล้ว — จะไม่ถูกอัปขึ้น GitHub
#  ไม่ใส่คีย์ = แอปทำงานต่อได้ปกติด้วย localStorage (โหมดเดโม)
# ============================================================

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ⚠️ ใส่ได้เฉพาะ anon / publishable key เท่านั้น
#    ห้ามใส่ service_role key ในไฟล์นี้เด็ดขาด (มันข้าม RLS ได้ทั้งหมด
#    และคีย์ทุกตัวใน VITE_* จะถูกฝังลงไฟล์ที่ผู้ใช้ทุกคนโหลดได้)
